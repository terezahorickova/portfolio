---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import { getBySection } from '../data/projects';

const projects = getBySection('product');
---

<BaseLayout title="Product">
  <ProjectGrid
    projects={projects}
    intro="Revival and preservation of craftsmanship, addressing environmental issues, toys for children, experimental materials."
  />
</BaseLayout>
