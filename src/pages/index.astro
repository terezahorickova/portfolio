---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { withBase } from '../utils/url';
import portrait from '../assets/front/portrait.jpg';
import productPhoto from '../assets/front/product.jpg';
import researchPhoto from '../assets/front/research.jpg';
import graphicsPhoto from '../assets/front/graphics.jpg';
import landartPhoto from '../assets/front/landart.jpg';
import photographyPhoto from '../assets/front/photography.jpg';
import sidequestsPhoto from '../assets/front/sidequests.jpg';
import squiggle from '../assets/front/squiggle.png';
import chevron from '../assets/front/chevron.png';
import heart from '../assets/front/heart.png';

const design = [
  { label: 'Product design', href: '/product', photo: productPhoto, alt: 'Detail of a bent beech AYA trestle' },
  { label: 'Research', href: '/research', photo: researchPhoto, alt: 'A bioplastic sample held up to the window' },
  { label: 'Graphic design', href: '/graphics', photo: graphicsPhoto, alt: 'A book and plant samples laid out on a white table' },
];

const interests = [
  { label: 'Landart', href: '/interests', photo: landartPhoto, alt: 'A round seed-like object lying in a field of wheat' },
  { label: 'Photography', href: '/interests', photo: photographyPhoto, alt: 'Thick mooring ropes coiled on a quay' },
  { label: 'Side quests', href: '/interests', photo: sidequestsPhoto, alt: 'People weaving willow in a workshop' },
];

// x / y are the position of each phrase as a percentage of the grey section.
const values = [
  { text: 'connect people', x: 40.6, y: 9 },
  { text: 'is simple', x: 21.7, y: 18.6 },
  { text: 'is playful', x: 71.7, y: 20 },
  { text: 'feels good', x: 56.2, y: 31.5 },
  { text: 'helps', x: 19, y: 63.8 },
  { text: 'builds communities', x: 48.3, y: 64.6 },
  { text: 'is sustainable', x: 31, y: 80.9 },
  { text: 'is practical', x: 67.8, y: 81.4 },
];
---

<BaseLayout title="Home" home>
  <!-- Hides the headline (until the build animation has played) before the page first paints. -->
  <script is:inline>
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('title-anim');
  </script>
  <section class="hero">
    <div class="hero-inner">
      <h1 class="hero-title">
        <span>Tereza</span>
        <span>Horičková</span>
      </h1>
      <p class="hero-text">
        Reviving crafts, exploring experimental materials, and addressing ecological challenges to create design
        that doesn’t just catch the eye — it speaks to every sense.
      </p>
    </div>
  </section>

  <div class="hero-blend" aria-hidden="true"></div>

  <section class="about wrap">
    <div class="about-left">
      <img class="squiggle" src={squiggle.src} width={squiggle.width} height={squiggle.height} alt="" />
      <div class="about-copy">
        <a class="about-label" href={withBase('/about')}>About</a>
        <p class="about-text">
          I am a designer and researcher based in Prague, who finds balance between the quiet wisdom of nature and
          the dynamic needs of modern society. My design work focuses on the revival and preservation of
          craftsmanship, addressing environmental issues, and creating toys for children, though experimental
          materials are also currently among my interests.
        </p>
      </div>
    </div>
    <div class="about-photo">
      <Image src={portrait} alt="Portrait of Tereza Horičková" widths={[400, 700, 1000]} sizes="(max-width: 780px) 100vw, 38vw" loading="eager" />
    </div>
  </section>

  <section class="cards wrap">
    {design.map((item) => (
      <a class="card" href={withBase(item.href)}>
        <span class="card-label">
          <span>{item.label}</span>
          <img class="chevron" src={chevron.src} width={chevron.width} height={chevron.height} alt="" />
        </span>
        <Image class="card-photo" src={item.photo} alt={item.alt} widths={[400, 700, 1000]} sizes="(max-width: 780px) 100vw, 31vw" />
      </a>
    ))}
  </section>

  <section class="values">
    <div class="values-stage">
      {values.map((v) => (
        <p class="value" style={`--x: ${v.x}; --y: ${v.y};`}>{v.text}</p>
      ))}
      <p class="values-title">
        <span>i</span>
        <img class="heart" src={heart.src} width={heart.width} height={heart.height} alt="love" />
        <span>when design</span>
      </p>
    </div>
  </section>

  <section class="interests wrap">
    <h2>My other interests</h2>
    <div class="cards">
      {interests.map((item) => (
        <a class="card" href={withBase(item.href)}>
          <span class="card-label">
            <span>{item.label}</span>
            <img class="chevron" src={chevron.src} width={chevron.width} height={chevron.height} alt="" />
          </span>
          <Image class="card-photo" src={item.photo} alt={item.alt} widths={[400, 700, 1000]} sizes="(max-width: 780px) 100vw, 31vw" />
        </a>
      ))}
    </div>
  </section>

  <section class="cta">
    <p>
      If you are interested in collaboration, contact me via{' '}
      <a href={site.instagramUrl} target="_blank" rel="noopener noreferrer">instagram</a> or{' '}
      <a href={`mailto:${site.email}`}>email</a>.
    </p>
  </section>
</BaseLayout>

<script>
  /*
    Headline build animation. The display font is made of square pixels, each
    exactly 1/13 of the font size, so the name is turned into a grid of cells.
    Every cell then falls from the top of the window, one grid step at a time,
    like a Tetris piece that speeds up as it falls, until the name is built
    from the bottom up. The real text takes over once everything has landed.
  */
  const root = document.documentElement;
  const title = document.querySelector<HTMLElement>('.hero-title');

  const reveal = () => root.classList.add('title-done');

  type Cell = { tx: number; ty: number; dx: number; dy: number; start: number; dur: number };

  /*
    The squares only match the real text exactly when one font pixel is a whole
    number of screen pixels, and when the text starts on a whole screen pixel.
    So the headline size is rounded to the nearest such size (a few percent off
    from the fluid size), and the title is nudged onto the pixel grid.
  */
  function snapTitle(titleEl: HTMLElement) {
    const dpr = window.devicePixelRatio || 1;
    const spans = [...titleEl.querySelectorAll<HTMLElement>('span')];
    titleEl.style.cssText = '';
    const natural = parseFloat(getComputedStyle(titleEl).fontSize);
    const fits = () => spans.every((el) => el.getBoundingClientRect().width <= titleEl.clientWidth * 1.02);
    let k = Math.max(1, Math.round((natural * dpr) / 13));
    const apply = () => {
      const size = (13 * k) / dpr;
      titleEl.style.fontSize = size + 'px';
      titleEl.style.lineHeight = Math.round(1.05 * size * dpr) / dpr + 'px';
    };
    apply();
    while (k > 1 && !fits()) {
      k--;
      apply();
    }
    // Nudge the first baseline and the left edge onto whole screen pixels.
    titleEl.style.position = 'relative';
    const probe = document.createElement('i');
    probe.style.cssText = 'display:inline-block;width:0;height:0';
    spans[0].append(probe);
    const baseline = probe.getBoundingClientRect().bottom;
    probe.remove();
    const left = spans[0].getBoundingClientRect().left;
    titleEl.style.left = Math.round(left * dpr) / dpr - left + 'px';
    titleEl.style.top = Math.round(baseline * dpr) / dpr - baseline + 'px';
  }

  async function build(titleEl: HTMLElement) {
    await document.fonts.load("100px 'Jacquarda Bastarda 9'", 'Tereza Horičková');
    snapTitle(titleEl);
    const lines = [...titleEl.querySelectorAll<HTMLElement>('span')];
    const style = getComputedStyle(titleEl);
    const fs = parseFloat(style.fontSize);
    const cell = fs / 13;
    const font = `${style.fontWeight} ${fs}px ${style.fontFamily}`;
    // The window without its scrollbar, so the canvas is drawn at exactly 1:1.
    const vw = document.documentElement.clientWidth;
    const vh = document.documentElement.clientHeight;
    const startScroll = window.scrollY;

    // 1. Read the pixels of every letter into grid cells (viewport coordinates).
    // Each letter is placed where the browser itself puts it, so the squares
    // line up with the real text that replaces them.
    const targets: { x: number; y: number }[] = [];
    const sample = document.createElement('canvas').getContext('2d', { willReadFrequently: true })!;
    const range = document.createRange();
    const pad = 2; // spare cells around a letter
    for (const line of lines) {
      const node = line.firstChild;
      if (!node || node.nodeType !== Node.TEXT_NODE) continue;
      const probe = document.createElement('i');
      probe.style.cssText = 'display:inline-block;width:0;height:0';
      line.append(probe);
      const baseline = probe.getBoundingClientRect().bottom;
      probe.remove();

      const text = node.textContent ?? '';
      for (let k = 0; k < text.length; k++) {
        if (text[k].trim() === '') continue;
        range.setStart(node, k);
        range.setEnd(node, k + 1);
        const box = range.getBoundingClientRect();
        sample.font = font;
        const m = sample.measureText(text[k]);
        const up = Math.ceil(m.fontBoundingBoxAscent / cell) + 1;
        const down = Math.ceil(m.fontBoundingBoxDescent / cell) + 1;
        const cols = Math.ceil(m.width / cell) + pad * 2;
        sample.canvas.width = Math.ceil(cols * cell);
        sample.canvas.height = Math.ceil((up + down) * cell);
        sample.font = font;
        sample.fillText(text[k], pad * cell, up * cell);
        const data = sample.getImageData(0, 0, sample.canvas.width, sample.canvas.height).data;
        for (let j = 0; j < up + down; j++) {
          for (let i = 0; i < cols; i++) {
            const px = Math.floor((i + 0.5) * cell);
            const py = Math.floor((j + 0.5) * cell);
            if (px < sample.canvas.width && data[(py * sample.canvas.width + px) * 4 + 3] > 128) {
              targets.push({ x: box.left + (i - pad) * cell, y: baseline + (j - up) * cell });
            }
          }
        }
      }
    }
    if (!targets.length) return reveal();

    // 2. Tetris: every cell drops straight down from above the window,
    // speeding up as it falls, one grid step at a time. The name builds from the bottom
    // up, and within a column the lower cells land first, so a falling cell
    // never passes through one that has already landed.
    const gravity = 90; // grid steps per second squared (higher = faster fall)
    const spread = 1.5; // seconds between the first and the last landing
    const top = Math.min(...targets.map((t) => t.y));
    const bottom = Math.max(...targets.map((t) => t.y));
    const columns = new Map<number, { x: number; y: number }[]>();
    for (const t of targets) {
      const key = Math.round(t.x);
      if (!columns.has(key)) columns.set(key, []);
      columns.get(key)!.push(t);
    }
    const cells: Cell[] = [];
    for (const members of columns.values()) {
      members.sort((a, b) => b.y - a.y);
      const times = members
        .map((t) => 0.4 + ((bottom - t.y) / (bottom - top || 1)) * spread + Math.random() * 0.35)
        .sort((a, b) => a - b);
      members.forEach((t, k) => {
        const steps = Math.ceil((t.y + cell) / cell);
        const dur = Math.sqrt(steps / gravity);
        cells.push({ tx: t.x, ty: t.y, dx: 0, dy: -steps * cell, start: times[k] - dur, dur });
      });
    }
    const first = Math.min(...cells.map((c) => c.start));
    for (const c of cells) c.start -= first;
    const end = Math.max(...cells.map((c) => c.start + c.dur));

    // 3. Draw it on a canvas laid over the whole window.
    const canvas = document.createElement('canvas');
    canvas.style.cssText = `position:fixed;top:0;left:0;width:${vw}px;height:${vh}px;z-index:100;pointer-events:none`;
    const dpr = window.devicePixelRatio || 1;
    canvas.width = Math.round(vw * dpr);
    canvas.height = Math.round(vh * dpr);
    document.body.append(canvas);
    const ctx = canvas.getContext('2d')!;
    ctx.scale(dpr, dpr);
    ctx.fillStyle = getComputedStyle(document.body).color;

    // The paragraph lands during the last stretch, so both texts finish together.
    const landTime = Math.min(0.4, end);
    let landed = false;
    let t0 = 0;
    let done = false;
    const finish = () => {
      if (done) return;
      done = true;
      reveal();
      canvas.remove();
      window.removeEventListener('resize', finish);
    };
    window.addEventListener('resize', finish);

    const frame = (now: number) => {
      if (done) return;
      t0 ||= now;
      const t = (now - t0) / 1000;
      const scrolled = startScroll - window.scrollY;
      if (!landed && t >= end - landTime) {
        landed = true;
        root.style.setProperty('--land', landTime + 's');
        root.classList.add('text-go');
      }
      ctx.clearRect(0, 0, vw, vh);
      for (const c of cells) {
        const p = Math.min(1, Math.max(0, (t - c.start) / c.dur));
        if (p === 0) continue;
        // Move in whole grid steps so the cells hop from square to square.
        const remaining = Math.ceil((1 - p * p) * ((Math.abs(c.dx) + Math.abs(c.dy)) / cell)) * cell;
        const x = c.tx + Math.sign(c.dx) * remaining;
        const y = c.ty + Math.sign(c.dy) * remaining + scrolled;
        const x0 = Math.round(x * dpr) / dpr;
        const y0 = Math.round(y * dpr) / dpr;
        ctx.fillRect(x0, y0, Math.round((x + cell) * dpr) / dpr - x0, Math.round((y + cell) * dpr) / dpr - y0);
      }
      if (t < end) requestAnimationFrame(frame);
      else finish();
    };
    requestAnimationFrame(frame);
  }

  if (title && root.classList.contains('title-anim')) {
    let pending = 0;
    window.addEventListener('resize', () => {
      cancelAnimationFrame(pending);
      pending = requestAnimationFrame(() => snapTitle(title));
    });
    build(title).catch((err) => {
      console.error('Title animation failed', err);
      reveal();
    });
  } else {
    reveal();
  }
</script>

<style>
  /* Everything is sized in vw (and capped) so the page scales like the mockup. */
  .wrap {
    width: var(--content-w);
    margin-inline: auto;
  }

  /* ---- Hero ---- */
  /* The green hero (together with the header above it) always fills the
     whole window on load, so no white strip shows below it. */
  .hero {
    background: var(--front-green);
    min-height: max(360px, calc(100vh - var(--header-h)));
    min-height: max(360px, calc(100svh - var(--header-h)));
  }

  /* A soft fade from the hero's green into the white page below it. */
  .hero-blend {
    height: clamp(32px, 4vw, 90px);
    background: linear-gradient(to bottom, var(--front-green), var(--color-bg));
  }

  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: 37% 1fr;
    padding: 5vw 0 6vw 14%;
  }

  .hero-title {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-weight: var(--fw-regular);
    font-size: clamp(40px, 5vw, 84px);
    line-height: 1.05;
  }

  /* While the build animation plays the real text is invisible (the canvas
     draws the squares). The CSS animation is a failsafe in case the script
     never finishes. */
  :global(html.title-anim:not(.title-done)) .hero-title {
    color: transparent;
    animation: title-failsafe 0s 6s forwards;
  }

  @keyframes title-failsafe {
    to {
      color: var(--color-text);
    }
  }

  /* The paragraph drops a few pixels into place, finishing together with the
     headline (the script adds .text-go in time for that). */
  .hero-text {
    transition:
      opacity var(--land, 0.4s) linear,
      transform var(--land, 0.4s) cubic-bezier(0.55, 0, 1, 0.45);
  }

  :global(html.title-anim:not(.text-go):not(.title-done)) .hero-text {
    opacity: 0;
    transform: translateY(-18px);
    animation: text-failsafe 0s 6s forwards;
  }

  @keyframes text-failsafe {
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* The paragraph sits exactly above the portrait below: the same column,
     the right 40% of the content width used by the About section. */
  .hero-text {
    position: absolute;
    top: 13vw;
    right: calc((100% - var(--content-w)) / 2);
    width: calc(var(--content-w) * 0.4);
    font-size: clamp(15px, 1.6vw, 24px);
    line-height: 1.45;
  }

  /* ---- About ---- */
  .about {
    display: grid;
    grid-template-columns: 1fr 40%;
    padding-top: 5vw;
  }

  .about-left {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 3vw;
  }

  .squiggle {
    width: clamp(120px, 20vw, 300px);
    height: auto;
    image-rendering: pixelated;
  }

  .about-copy {
    display: flex;
    flex-direction: column;
    gap: 1.4vw;
    max-width: 64%;
  }

  .about-label,
  .about-text {
    font-size: clamp(13px, 1.05vw, 17px);
    line-height: 1.4;
  }

  .about-label {
    align-self: flex-start;
  }

  .about-photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  /* ---- Photo rows ---- */
  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }

  .about + .cards {
    margin-top: 8vw;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 1.4vw;
  }

  .card-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-right: 22%;
    font-size: clamp(15px, 1.8vw, 24px);
  }

  .chevron {
    height: clamp(13px, 2vw, 26px);
    width: auto;
  }

  .card-photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  /* ---- Values (grey) ---- */
  .values {
    margin-top: 8.7vw;
    background: var(--front-grey);
  }

  .values-stage {
    position: relative;
    height: min(56vw, 900px);
  }

  .value {
    position: absolute;
    left: calc(var(--x) * 1%);
    top: calc(var(--y) * 1%);
    white-space: nowrap;
    font-size: clamp(15px, 1.9vw, 26px);
  }

  .values-title {
    position: absolute;
    left: 50%;
    top: 47.5%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    gap: 0.35em;
    white-space: nowrap;
    font-family: var(--font-display);
    font-weight: var(--fw-regular);
    font-size: clamp(30px, 4.8vw, 80px);
    line-height: 1;
  }

  .heart {
    height: 0.8em;
    width: auto;
    image-rendering: pixelated;
  }

  /* ---- Other interests ---- */
  .interests {
    padding-top: 7.7vw;
  }

  .interests h2 {
    margin-bottom: 4.5vw;
    font-weight: var(--fw-regular);
    font-size: clamp(26px, 3.5vw, 56px);
    line-height: 1.1;
  }

  /* ---- Closing line (the green footer continues below it) ---- */
  .cta {
    margin-top: 8.7vw;
    padding: 9vw 24px 0;
    /* White fades into the green over the first stretch, like under the hero. */
    background: linear-gradient(to bottom, var(--color-bg), var(--front-green) clamp(32px, 4vw, 90px));
    text-align: center;
  }

  .cta p {
    max-width: 30em;
    margin-inline: auto;
    font-size: clamp(15px, 1.9vw, 24px);
    line-height: 1.4;
  }

  .cta a {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  /* ---- Phones and tablets: a single readable column ---- */
  @media (max-width: 780px) {
    .wrap {
      width: auto;
      margin-inline: var(--container-pad);
    }

    .hero-inner {
      display: block;
      padding: 40px var(--space-5) 56px;
    }

    .hero-title {
      font-size: 44px;
    }

    .hero-text {
      position: static;
      width: auto;
      margin-top: var(--space-6);
      font-size: var(--text-2);
    }

    .about {
      grid-template-columns: 1fr;
      gap: var(--space-6);
      padding-top: var(--space-8);
    }

    .about-left {
      gap: var(--space-5);
    }

    .about-copy {
      gap: var(--space-3);
      max-width: none;
    }

    .about-label,
    .about-text {
      font-size: var(--text-1);
    }

    .squiggle {
      width: 160px;
    }

    .cards {
      grid-template-columns: 1fr;
      gap: var(--space-7);
    }

    .about + .cards {
      margin-top: var(--space-8);
    }

    .card {
      gap: var(--space-3);
    }

    .card-label {
      padding-right: 0;
      font-size: var(--text-2);
    }

    .chevron {
      height: 20px;
    }

    .values {
      margin-top: var(--space-9);
    }

    .values-stage {
      height: auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-4);
      padding: var(--space-9) var(--space-5);
    }

    .value,
    .values-title {
      position: static;
      transform: none;
    }

    .value {
      font-size: var(--text-2);
    }

    .values-title {
      order: -1;
      margin-bottom: var(--space-5);
      font-size: 36px;
    }

    .interests {
      padding-top: var(--space-9);
    }

    .interests h2 {
      margin-bottom: var(--space-6);
      font-size: 32px;
    }

    .cta {
      margin-top: var(--space-9);
      padding-top: var(--space-9);
    }

    .cta p {
      font-size: var(--text-2);
    }
  }
</style>
