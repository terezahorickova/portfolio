---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

// Every project page uses this one layout. Each part below is optional
// and is simply left out until the project has content for it — see
// Project / ProjectDetail in src/data/projects.ts.
const { project } = Astro.props;
const cardColor = project.color.startsWith('#') ? project.color : `var(--${project.color})`;
const detail = project.detail;
const subtitle = [project.subtitle ?? project.description, project.year].filter(Boolean).join(', ');
const hero = detail?.hero === null ? undefined : (detail?.hero ?? project.cover);
const bodyParagraphs = project.body ? project.body.split(/\n\s*\n/) : [];
const gallery = detail?.gallery ?? [];
// The gallery is laid out in order. Full-width photos stand alone; the other
// photos form aligned sections, and a new section starts at the first photo
// and wherever a photo has `sync`.
type Item = (typeof gallery)[number] & { index: number };
const blocks: ({ kind: 'full'; image: Item } | { kind: 'section'; list: Item[] })[] = [];
let current: Item[] | null = null;
gallery.forEach((image, index) => {
  const item = { ...image, index };
  if (image.col === 'full') {
    current = null;
    blocks.push({ kind: 'full', image: item });
    return;
  }
  if (!current || image.sync) {
    current = [];
    blocks.push({ kind: 'section', list: current });
  }
  current.push(item);
});
const steps = detail?.steps;
// Tiles with a phone version (e.g. a square crop) get a <source> for narrow screens.
const phoneSources = new Map<number, string>();
await Promise.all(
  (detail?.mosaic ?? []).map(async (tile, index) => {
    if (!tile.phoneSrc) return;
    const widths = [600, 900, 1200, 1800];
    const images = await Promise.all(widths.map((width) => getImage({ src: tile.phoneSrc!, width, format: 'webp' })));
    phoneSources.set(index, images.map((image, i) => `${image.src} ${widths[i]}w`).join(', '));
  }),
);
const mosaic = detail?.mosaic;
// An optional empty row (the breathing space under the text) between the first and the following tiles.
const spacer = detail?.mosaicSpacer;
const mosaicRows = spacer ? `grid-template-rows: repeat(${spacer.row - 1}, var(--unit)) calc(var(--unit) * ${spacer.size});` : '';
---

<BaseLayout title={project.title} wide={!!mosaic}>
  <script is:inline>
    // Lets the photos below the opening rise into place as they scroll into view (see .mosaic-tile[data-reveal]).
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
      document.documentElement.classList.add('reveal-ready');
    // Failsafe: if the script below never starts, show the photos normally.
    window.__revealGuard = setTimeout(() => document.documentElement.classList.remove('reveal-ready'), 4000);
    }
  </script>
  {mosaic ? (
    <article class="mosaic">
      <div class:list={['mosaic-grid', { 'mosaic-grid--centered': detail?.centerFirstScreen }]} style={mosaicRows}>
        <div class:list={['mosaic-text', { 'mosaic-text--aligned': detail?.centerFirstScreen }]}>
          <h1>{project.title}</h1>
          <p class="subtitle">{subtitle}</p>
          {bodyParagraphs.map((text) => <p class="story-body">{text}</p>)}
          {detail?.credits && (
            <p class="credits">
              {detail.credits.map((line) => (
                <span>{line}</span>
              ))}
            </p>
          )}
        </div>
        {mosaic.map((tile, index) => (
          <div
            class={`mosaic-tile mosaic-tile--${tile.shape}`}
            style={`--c: ${tile.col}; --r: ${tile.row}; --i: ${index}; --d: ${(tile.col - 1) * 90}ms;`}
            data-reveal={index > 0 ? '' : undefined}
          >
            {phoneSources.has(index) && (
              <picture>
                <source media="(max-width: 780px)" srcset={phoneSources.get(index)} sizes="100vw" />
                <Image
                  src={tile.src}
                  alt={tile.alt}
                  widths={[900, 1400, 2000, 2400]}
                  sizes="67vw"
                  loading="eager"
                />
              </picture>
            )}
            {!phoneSources.has(index) && (
            <Image
              src={tile.src}
              alt={tile.alt}
              widths={tile.shape === 'wide' ? [900, 1400, 2000, 2400] : [500, 800, 1200, 1600]}
              sizes={tile.shape === 'wide' ? '(max-width: 780px) 100vw, 67vw' : '(max-width: 780px) 100vw, 33vw'}
              loading={index < 3 ? 'eager' : 'lazy'}
            />
            )}
          </div>
        ))}
      </div>
    </article>
  ) : (
  <article class="story" style={`--card-color: ${cardColor};`}>
    <section class="intro">
      {detail?.intro && (
        <div class="intro-photo">
          <Image src={detail.intro} alt={`${project.title} in use`} widths={[600, 1000, 1400]} sizes="(max-width: 780px) 100vw, 560px" loading="eager" />
        </div>
      )}
      <div class="intro-text">
        <h1>{project.title}</h1>
        <p class="subtitle">{subtitle}</p>
        {bodyParagraphs.length > 0 ? (
          bodyParagraphs.map((text) => <p class="story-body">{text}</p>)
        ) : (
          <p class="placeholder-note">Full case study for this project is coming soon.</p>
        )}
        {detail?.credits && (
          <p class="credits">
            {detail.credits.map((line) => (
              <span>{line}</span>
            ))}
          </p>
        )}
      </div>
    </section>

    {hero && detail?.heroAnimated ? (
      <img class="hero" src={hero.src} alt={project.title} width={hero.width} height={hero.height} loading="eager" />
    ) : hero ? (
      <Image
        class="hero"
        src={hero}
        alt={project.title}
        widths={[800, 1400, 1800, 2400]}
        sizes="(max-width: 1440px) 100vw, 1376px"
        loading="eager"
      />
    ) : (
      <div class="hero-placeholder" aria-hidden="true">
        <span>Photo coming soon</span>
      </div>
    )}

    {detail?.columns && (
      <section class="columns">
        {detail.columns.map((paragraphs) => (
          <div class="column">
            {paragraphs.map((text) => (
              <p>{text}</p>
            ))}
          </div>
        ))}
      </section>
    )}

    {gallery.length > 0 && (
      <section class="gallery">
        {blocks.map((block) =>
          block.kind === 'full' ? (
            <Image
              class="gallery-img gallery-img--full"
              style={`--size: ${block.image.size ?? 100}%; --i: ${block.image.index};`}
              src={block.image.src}
              alt={block.image.alt}
              widths={[900, 1600, 2400]}
              sizes="(max-width: 1440px) 100vw, 1376px"
              loading="lazy"
            />
          ) : (
          <div class="gallery-section">
            {(['left', 'right'] as const).map((col) => ({ col, items: block.list.filter((image) => image.col === col) })).map(({ col, items }) => (
              <div class={`gallery-col gallery-col--${col}`}>
                {items.map((image) =>
                  image.animated ? (
                    <img
                      class="gallery-img"
                      style={`--size: ${image.size ?? 100}%; --i: ${image.index};`}
                      src={image.src.src}
                      alt={image.alt}
                      width={image.src.width}
                      height={image.src.height}
                      loading="lazy"
                    />
                  ) : (
                    <Image
                      class="gallery-img"
                      style={`--size: ${image.size ?? 100}%; --i: ${image.index};`}
                      src={image.src}
                      alt={image.alt}
                      widths={[500, 900, 1300]}
                      sizes="(max-width: 780px) 100vw, 600px"
                      loading="lazy"
                    />
                  ),
                )}
              </div>
            ))}
          </div>
          ),
        )}
      </section>
    )}

    {steps && (
      <section class="steps">
        <h2>{steps.title}</h2>
        <ol class="steps-list">
          {steps.items.map((step, index) => (
            <li class="step">
              <Image src={step.src} alt={step.alt} widths={[300, 500, 700]} sizes="(max-width: 780px) 50vw, 270px" loading="lazy" />
              <p><span class="step-number">{index + 1}.</span> {step.caption}</p>
            </li>
          ))}
        </ol>
      </section>
    )}
  </article>
  )}
</BaseLayout>

<script>
  const root = document.documentElement;
  const tiles = document.querySelectorAll<HTMLElement>('.mosaic-tile[data-reveal]');
  clearTimeout((window as any).__revealGuard);

  if (root.classList.contains('reveal-ready') && tiles.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-in');
          observer.unobserve(entry.target);
        }
      },
      { threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
    );
    tiles.forEach((tile) => observer.observe(tile));
  }
</script>

<style>
  /* ---- Mosaic layout (projects with `detail.mosaic`) ----
     3 equal columns; one grid row is half a portrait photo (a 3:4
     portrait spans 2 rows, a 3:2 landscape spans 1), so tiles stack
     corner to corner. */
  .mosaic {
    container-type: inline-size;
    padding-bottom: var(--space-9);
  }

  .mosaic-grid {
    --gap: 10px;
    --cell: calc((100cqw - 2 * var(--gap)) / 3);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: var(--gap);
    --unit: calc(var(--cell) * 2 / 3);
    grid-auto-rows: var(--unit);
  }

  /* Text fills exactly one column (the same width as the photo columns),
     bottom-aligned beside the first photo, and scales with the column
     width so it always fits the two rows. */
  .mosaic-text {
    grid-column: 1;
    grid-row: 1 / span 2;
    align-self: end;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: 0 0 var(--space-5);
    font-size: clamp(11px, calc(var(--cell) * 0.026), 15px);
  }

  /* Refined opening (desktop): the text is 4 of 18 grid columns wide (the 3
     main columns are 6 columns each) and ends level with the bottom of the photo. */
  @media (min-width: 1200px) {
    .mosaic-text--aligned {
      width: calc(var(--cell) * 2 / 3 - var(--gap) / 3);
      padding-bottom: 0;
    }
  }

  .mosaic-text h1 {
    font-size: clamp(28px, calc(var(--cell) * 0.07), 48px);
    line-height: var(--line-tight);
  }

  .mosaic-text .subtitle {
    font-size: clamp(13px, calc(var(--cell) * 0.036), 20px);
  }

  /* Refined opening (desktop): a headline twice the size, and the headline
     with its subtitle lifted a little away from the paragraph below. */
  @media (min-width: 1200px) {
    .mosaic-text--aligned h1 {
      font-size: clamp(56px, calc(var(--cell) * 0.14), 96px);
    }

    .mosaic-text--aligned .subtitle {
      margin-bottom: calc(var(--cell) * 0.07);
    }
  }

  .mosaic-text .story-body,
  .mosaic-text .credits {
    font-size: inherit;
    line-height: 1.45;
  }

  .mosaic-tile {
    grid-column: var(--c);
    overflow: hidden;
  }

  /* Photos below the opening rise a short way and fade in as they scroll into
     view. Photos in the same row follow each other by a fraction of a second. */
  .mosaic-tile[data-reveal] {
    transition:
      opacity 0.9s ease,
      transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1);
    transition-delay: var(--d, 0ms);
  }

  :global(html.reveal-ready) .mosaic-tile[data-reveal]:not(.is-in) {
    opacity: 0;
    transform: translateY(40px);
  }

  .mosaic-tile--portrait {
    grid-row: var(--r) / span 2;
  }

  .mosaic-tile--landscape {
    grid-row: var(--r) / span 1;
  }

  /* Two columns wide, two rows tall: 3:2 like a landscape photo, just larger. */
  .mosaic-tile--wide {
    grid-column: var(--c) / span 2;
    grid-row: var(--r) / span 2;
  }

  .mosaic-tile :global(picture) {
    display: contents;
  }

  .mosaic-tile :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Desktop: the opening photo is two rows tall (4/3 of a column). Pull the
     grid up so that photo sits in the middle of the window, but never higher
     than 64px from the top, which keeps it clear of the menu, and never lower
     than its normal place under the header. */
  @media (min-width: 1200px) {
    .mosaic-grid--centered {
      margin-top: clamp(
        calc(64px - var(--header-h)),
        calc((100svh - var(--cell) * 4 / 3) / 2 - var(--header-h)),
        0px
      );
    }
  }

  @media (max-width: 1199px) {
    .mosaic-grid {
      display: flex;
      flex-direction: column;
      gap: var(--grid-gap-y);
      max-width: 720px;
      margin-inline: auto;
    }

    .mosaic-text {
      order: -1;
      padding: 0;
      font-size: var(--text-1);
    }

    /* Refined opening: the opening photo comes first, then the text. */
    .mosaic-text--aligned {
      order: 1;
    }

    .mosaic-text h1 {
      font-size: var(--text-5);
    }

    .mosaic-text .subtitle {
      font-size: var(--text-2);
    }

    .mosaic-tile {
      order: var(--i);
    }

    .mosaic-tile--portrait {
      aspect-ratio: 3 / 4;
    }

    .mosaic-tile--landscape,
    .mosaic-tile--wide {
      aspect-ratio: 3 / 2;
    }
  }

  /* Phones, refined opening: the first photo is a square that fills the whole
     width of the screen, directly under the (sticky) header. The text follows
     it, a little larger; the other photos keep their margins. */
  @media (max-width: 780px) {
    .mosaic-grid--centered {
      margin-top: -50px; /* cancels the page's top padding */
    }

    .mosaic-grid--centered .mosaic-tile--wide {
      position: relative;
      aspect-ratio: 1 / 1;
      width: calc(100% + 2 * var(--space-5));
      margin-inline: calc(-1 * var(--space-5));
    }

    /* The photo is laid over the square, so its own shape can never stretch the box. */
    .mosaic-grid--centered .mosaic-tile--wide :global(img) {
      position: absolute;
      inset: 0;
    }

    .mosaic-text--aligned h1 {
      font-size: var(--text-6);
    }
  }

  .story {
    display: flex;
    flex-direction: column;
    gap: var(--grid-gap-y);
    padding-bottom: var(--space-9);
  }

  .intro {
    display: grid;
    grid-template-columns: 60% 40%;
    align-items: start;
  }

  .intro-photo img {
    display: block;
    width: 67%;
    height: auto;
  }

  .intro-text {
    grid-column: 2;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  /* The display font's capitals are hard to read, so project names are set in lowercase. */
  h1 {
    font-family: var(--font-display);
    font-weight: var(--fw-regular);
    font-size: var(--text-5);
    text-transform: lowercase;
  }

  .subtitle {
    font-size: var(--text-2);
  }

  .story-body {
    font-size: var(--text-1);
    line-height: var(--line-normal);
    margin-top: var(--space-2);
  }

  .story-body + .story-body {
    margin-top: var(--space-1);
  }

  .placeholder-note {
    font-size: var(--text-1);
    color: var(--color-muted);
    font-style: italic;
    margin-top: var(--space-2);
  }

  .credits {
    display: flex;
    flex-direction: column;
    margin-top: var(--space-5);
    font-size: var(--text-1);
    line-height: var(--line-normal);
  }

  .hero {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero-placeholder {
    aspect-ratio: 3 / 2;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--card-color);
    color: var(--color-text);
    font-size: var(--text-1);
  }

  .columns {
    display: grid;
    grid-template-columns: 8.5% 32% 19.5% 32%;
  }

  .column {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .column:first-child {
    grid-column: 2;
  }

  .column:last-child {
    grid-column: 4;
  }

  .column p {
    font-size: var(--text-1);
    line-height: var(--line-normal);
  }

  .gallery {
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
  }

  .gallery-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 100px;
    align-items: start;
  }

  /* A full-width photo followed by a row of photos gets the same 100px
     breathing room as between the page's main sections. */
  .gallery-img--full + .gallery-section {
    margin-top: var(--grid-gap-y);
  }

  .gallery-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
  }

  .gallery-col--left {
    align-items: flex-start;
  }

  .gallery-col--right {
    align-items: flex-end;
  }

  .gallery-img {
    display: block;
    width: var(--size);
    height: auto;
  }

  .steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
  }

  .steps h2 {
    font-weight: var(--fw-regular);
    font-size: var(--text-4);
    line-height: var(--line-tight);
  }

  .steps-list {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-4);
  }

  .step {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .step :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  .step p {
    font-size: var(--text-1);
    line-height: var(--line-normal);
    color: var(--color-muted);
  }

  .step-number {
    display: block;
  }

  @media (max-width: 780px) {
    .steps-list {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-5) var(--space-3);
    }

    .intro,
    .columns {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .intro-photo img {
      width: 100%;
    }

    .intro-text {
      grid-column: 1;
    }

    .column:first-child,
    .column:last-child {
      grid-column: 1;
    }

    .gallery,
    .gallery-section {
      display: flex;
      flex-direction: column;
      gap: var(--grid-gap-y);
    }

    .gallery-col {
      display: contents;
    }

    .gallery-img {
      width: 100%;
      order: var(--i);
    }
  }
</style>
