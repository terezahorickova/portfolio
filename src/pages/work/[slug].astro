---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

// Every project page uses this one layout. Each part below is optional
// and is simply left out until the project has content for it — see
// Project / ProjectDetail in src/data/projects.ts.
const { project } = Astro.props;
const cardColor = project.color.startsWith('#') ? project.color : `var(--${project.color})`;
const detail = project.detail;
const subtitle = [project.description, project.year].filter(Boolean).join(', ');
const hero = detail?.hero ?? project.cover;
const gallery = detail?.gallery ?? [];
const galleryCols = (['left', 'right'] as const).map((col) => ({
  col,
  items: gallery.map((image, index) => ({ ...image, index })).filter((image) => image.col === col),
}));
---

<BaseLayout title={project.title}>
  <article class="story" style={`--card-color: ${cardColor};`}>
    <section class="intro">
      {detail?.intro && (
        <div class="intro-photo">
          <Image src={detail.intro} alt={`${project.title} in use`} widths={[600, 1000]} sizes="(max-width: 780px) 100vw, 360px" loading="eager" />
        </div>
      )}
      <div class="intro-text">
        <h1>{project.title}</h1>
        <p class="subtitle">{subtitle}</p>
        {project.body ? (
          <p class="story-body">{project.body}</p>
        ) : (
          <p class="placeholder-note">Full case study for this project is coming soon.</p>
        )}
        {detail?.credits && (
          <p class="credits">
            {detail.credits.map((line) => (
              <span>{line}</span>
            ))}
          </p>
        )}
      </div>
    </section>

    {hero ? (
      <Image
        class="hero"
        src={hero}
        alt={project.title}
        widths={[800, 1400, 1800]}
        sizes="(max-width: 940px) 100vw, 900px"
        loading="eager"
      />
    ) : (
      <div class="hero-placeholder" aria-hidden="true">
        <span>Photo coming soon</span>
      </div>
    )}

    {detail?.columns && (
      <section class="columns">
        {detail.columns.map((paragraphs) => (
          <div class="column">
            {paragraphs.map((text) => (
              <p>{text}</p>
            ))}
          </div>
        ))}
      </section>
    )}

    {gallery.length > 0 && (
      <section class="gallery">
        {galleryCols.map(({ col, items }) => (
          <div class={`gallery-col gallery-col--${col}`}>
            {items.map((image) => (
              <Image
                class="gallery-img"
                style={`--size: ${image.size ?? 100}%; --i: ${image.index};`}
                src={image.src}
                alt={image.alt}
                widths={[500, 900]}
                sizes="(max-width: 780px) 100vw, 450px"
                loading="lazy"
              />
            ))}
          </div>
        ))}
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .story {
    display: flex;
    flex-direction: column;
    gap: var(--grid-gap-y);
    max-width: 900px;
    margin-inline: auto;
    padding-bottom: var(--space-9);
  }

  .intro {
    display: grid;
    grid-template-columns: 60% 40%;
    align-items: start;
  }

  .intro-photo img {
    display: block;
    width: 67%;
    height: auto;
  }

  .intro-text {
    grid-column: 2;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  h1 {
    font-family: var(--font-display);
    font-weight: var(--fw-regular);
    font-size: var(--text-5);
  }

  .subtitle {
    font-size: var(--text-2);
  }

  .story-body {
    font-size: var(--text-1);
    line-height: var(--line-normal);
    margin-top: var(--space-2);
  }

  .placeholder-note {
    font-size: var(--text-1);
    color: var(--color-muted);
    font-style: italic;
    margin-top: var(--space-2);
  }

  .credits {
    display: flex;
    flex-direction: column;
    margin-top: var(--space-5);
    font-size: var(--text-1);
    line-height: var(--line-normal);
  }

  .hero {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero-placeholder {
    aspect-ratio: 3 / 2;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--card-color);
    color: var(--color-text);
    font-size: var(--text-1);
  }

  .columns {
    display: grid;
    grid-template-columns: 8.5% 32% 19.5% 32%;
  }

  .column {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .column:first-child {
    grid-column: 2;
  }

  .column:last-child {
    grid-column: 4;
  }

  .column p {
    font-size: var(--text-1);
    line-height: var(--line-normal);
  }

  .gallery {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 100px;
    align-items: start;
  }

  .gallery-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
  }

  .gallery-col--left {
    align-items: flex-start;
  }

  .gallery-col--right {
    align-items: flex-end;
  }

  .gallery-img {
    display: block;
    width: var(--size);
    height: auto;
  }

  @media (max-width: 780px) {
    .intro,
    .columns {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .intro-photo img {
      width: 100%;
    }

    .intro-text {
      grid-column: 1;
    }

    .column:first-child,
    .column:last-child {
      grid-column: 1;
    }

    .gallery {
      display: flex;
      flex-direction: column;
      gap: var(--grid-gap-y);
    }

    .gallery-col {
      display: contents;
    }

    .gallery-img {
      width: 100%;
      order: var(--i);
    }
  }
</style>
