---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

// Every project page uses this one layout. Each part below is optional
// and is simply left out until the project has content for it — see
// Project / ProjectDetail in src/data/projects.ts.
const { project } = Astro.props;
const cardColor = project.color.startsWith('#') ? project.color : `var(--${project.color})`;
const detail = project.detail;
const subtitle = [project.description, project.year].filter(Boolean).join(', ');
const hero = detail?.hero ?? project.cover;
const bodyParagraphs = project.body ? project.body.split(/\n\s*\n/) : [];
const gallery = detail?.gallery ?? [];
const fullImages = gallery
  .map((image, index) => ({ ...image, index }))
  .filter((image) => image.col === 'full');
// A new aligned section starts at the first photo, and wherever a photo has `sync`.
const sectionLists: ((typeof gallery)[number] & { index: number })[][] = [];
gallery.forEach((image, index) => {
  if (image.col === 'full') return;
  if (sectionLists.length === 0 || image.sync) sectionLists.push([]);
  sectionLists[sectionLists.length - 1].push({ ...image, index });
});
const sections = sectionLists.map((list) =>
  (['left', 'right'] as const).map((col) => ({ col, items: list.filter((image) => image.col === col) })),
);
const mosaic = detail?.mosaic;
---

<BaseLayout title={project.title} wide={!!mosaic}>
  {mosaic ? (
    <article class="mosaic">
      <div class="mosaic-grid">
        <div class="mosaic-text">
          <h1>{project.title}</h1>
          <p class="subtitle">{subtitle}</p>
          {bodyParagraphs.map((text) => <p class="story-body">{text}</p>)}
          {detail?.credits && (
            <p class="credits">
              {detail.credits.map((line) => (
                <span>{line}</span>
              ))}
            </p>
          )}
        </div>
        {mosaic.map((tile, index) => (
          <div
            class={`mosaic-tile mosaic-tile--${tile.shape}`}
            style={`--c: ${tile.col}; --r: ${tile.row}; --i: ${index};`}
          >
            <Image
              src={tile.src}
              alt={tile.alt}
              widths={[500, 800, 1200, 1600]}
              sizes="(max-width: 780px) 100vw, 33vw"
              loading={index < 3 ? 'eager' : 'lazy'}
            />
          </div>
        ))}
      </div>
    </article>
  ) : (
  <article class="story" style={`--card-color: ${cardColor};`}>
    <section class="intro">
      {detail?.intro && (
        <div class="intro-photo">
          <Image src={detail.intro} alt={`${project.title} in use`} widths={[600, 1000, 1400]} sizes="(max-width: 780px) 100vw, 560px" loading="eager" />
        </div>
      )}
      <div class="intro-text">
        <h1>{project.title}</h1>
        <p class="subtitle">{subtitle}</p>
        {bodyParagraphs.length > 0 ? (
          bodyParagraphs.map((text) => <p class="story-body">{text}</p>)
        ) : (
          <p class="placeholder-note">Full case study for this project is coming soon.</p>
        )}
        {detail?.credits && (
          <p class="credits">
            {detail.credits.map((line) => (
              <span>{line}</span>
            ))}
          </p>
        )}
      </div>
    </section>

    {hero && detail?.heroAnimated ? (
      <img class="hero" src={hero.src} alt={project.title} width={hero.width} height={hero.height} loading="eager" />
    ) : hero ? (
      <Image
        class="hero"
        src={hero}
        alt={project.title}
        widths={[800, 1400, 1800, 2400]}
        sizes="(max-width: 1440px) 100vw, 1376px"
        loading="eager"
      />
    ) : (
      <div class="hero-placeholder" aria-hidden="true">
        <span>Photo coming soon</span>
      </div>
    )}

    {detail?.columns && (
      <section class="columns">
        {detail.columns.map((paragraphs) => (
          <div class="column">
            {paragraphs.map((text) => (
              <p>{text}</p>
            ))}
          </div>
        ))}
      </section>
    )}

    {gallery.length > 0 && (
      <section class="gallery">
        {sections.map((cols) => (
          <div class="gallery-section">
            {cols.map(({ col, items }) => (
              <div class={`gallery-col gallery-col--${col}`}>
                {items.map((image) =>
                  image.animated ? (
                    <img
                      class="gallery-img"
                      style={`--size: ${image.size ?? 100}%; --i: ${image.index};`}
                      src={image.src.src}
                      alt={image.alt}
                      width={image.src.width}
                      height={image.src.height}
                      loading="lazy"
                    />
                  ) : (
                    <Image
                      class="gallery-img"
                      style={`--size: ${image.size ?? 100}%; --i: ${image.index};`}
                      src={image.src}
                      alt={image.alt}
                      widths={[500, 900, 1300]}
                      sizes="(max-width: 780px) 100vw, 600px"
                      loading="lazy"
                    />
                  ),
                )}
              </div>
            ))}
          </div>
        ))}
        {fullImages.map((image) => (
          <Image
            class="gallery-img gallery-img--full"
            style={`--size: ${image.size ?? 100}%; --i: ${image.index};`}
            src={image.src}
            alt={image.alt}
            widths={[900, 1600, 2400]}
            sizes="(max-width: 1440px) 100vw, 1376px"
            loading="lazy"
          />
        ))}
      </section>
    )}
  </article>
  )}
</BaseLayout>

<style>
  /* ---- Mosaic layout (projects with `detail.mosaic`) ----
     3 equal columns; one grid row is half a portrait photo (a 3:4
     portrait spans 2 rows, a 3:2 landscape spans 1), so tiles stack
     corner to corner. */
  .mosaic {
    container-type: inline-size;
    padding-bottom: var(--space-9);
  }

  .mosaic-grid {
    --gap: 10px;
    --cell: calc((100cqw - 2 * var(--gap)) / 3);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: var(--gap);
    grid-auto-rows: calc(var(--cell) * 2 / 3);
  }

  /* Text fills exactly one column (the same width as the photo columns),
     bottom-aligned beside the first photo, and scales with the column
     width so it always fits the two rows. */
  .mosaic-text {
    grid-column: 1;
    grid-row: 1 / span 2;
    align-self: end;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: 0 0 var(--space-5);
    font-size: clamp(11px, calc(var(--cell) * 0.026), 15px);
  }

  .mosaic-text h1 {
    font-size: clamp(28px, calc(var(--cell) * 0.07), 48px);
    line-height: var(--line-tight);
  }

  .mosaic-text .subtitle {
    font-size: clamp(13px, calc(var(--cell) * 0.036), 20px);
  }

  .mosaic-text .story-body,
  .mosaic-text .credits {
    font-size: inherit;
    line-height: 1.45;
  }

  .mosaic-tile {
    grid-column: var(--c);
    overflow: hidden;
  }

  .mosaic-tile--portrait {
    grid-row: var(--r) / span 2;
  }

  .mosaic-tile--landscape {
    grid-row: var(--r) / span 1;
  }

  .mosaic-tile :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 1199px) {
    .mosaic-grid {
      display: flex;
      flex-direction: column;
      gap: var(--grid-gap-y);
      max-width: 720px;
      margin-inline: auto;
    }

    .mosaic-text {
      order: -1;
      padding: 0;
      font-size: var(--text-1);
    }

    .mosaic-text h1 {
      font-size: var(--text-5);
    }

    .mosaic-text .subtitle {
      font-size: var(--text-2);
    }

    .mosaic-tile {
      order: var(--i);
    }

    .mosaic-tile--portrait {
      aspect-ratio: 3 / 4;
    }

    .mosaic-tile--landscape {
      aspect-ratio: 3 / 2;
    }
  }

  .story {
    display: flex;
    flex-direction: column;
    gap: var(--grid-gap-y);
    padding-bottom: var(--space-9);
  }

  .intro {
    display: grid;
    grid-template-columns: 60% 40%;
    align-items: start;
  }

  .intro-photo img {
    display: block;
    width: 67%;
    height: auto;
  }

  .intro-text {
    grid-column: 2;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  h1 {
    font-family: var(--font-display);
    font-weight: var(--fw-regular);
    font-size: var(--text-5);
  }

  .subtitle {
    font-size: var(--text-2);
  }

  .story-body {
    font-size: var(--text-1);
    line-height: var(--line-normal);
    margin-top: var(--space-2);
  }

  .story-body + .story-body {
    margin-top: var(--space-1);
  }

  .placeholder-note {
    font-size: var(--text-1);
    color: var(--color-muted);
    font-style: italic;
    margin-top: var(--space-2);
  }

  .credits {
    display: flex;
    flex-direction: column;
    margin-top: var(--space-5);
    font-size: var(--text-1);
    line-height: var(--line-normal);
  }

  .hero {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero-placeholder {
    aspect-ratio: 3 / 2;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--card-color);
    color: var(--color-text);
    font-size: var(--text-1);
  }

  .columns {
    display: grid;
    grid-template-columns: 8.5% 32% 19.5% 32%;
  }

  .column {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .column:first-child {
    grid-column: 2;
  }

  .column:last-child {
    grid-column: 4;
  }

  .column p {
    font-size: var(--text-1);
    line-height: var(--line-normal);
  }

  .gallery {
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
  }

  .gallery-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 100px;
    align-items: start;
  }

  .gallery-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
  }

  .gallery-col--left {
    align-items: flex-start;
  }

  .gallery-col--right {
    align-items: flex-end;
  }

  .gallery-img {
    display: block;
    width: var(--size);
    height: auto;
  }

  @media (max-width: 780px) {
    .intro,
    .columns {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .intro-photo img {
      width: 100%;
    }

    .intro-text {
      grid-column: 1;
    }

    .column:first-child,
    .column:last-child {
      grid-column: 1;
    }

    .gallery,
    .gallery-section {
      display: flex;
      flex-direction: column;
      gap: var(--grid-gap-y);
    }

    .gallery-col {
      display: contents;
    }

    .gallery-img {
      width: 100%;
      order: var(--i);
    }
  }
</style>
