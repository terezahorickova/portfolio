---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import { getBySection, interestFilters } from '../data/projects';

const projects = getBySection('interests');
---

<BaseLayout title="Interests">
  <ProjectGrid
    projects={projects}
    intro="A collection of things made with my hands, moments gathered along the way, and side projects that keep me inspired."
    filters={[...interestFilters]}
  />
</BaseLayout>
