---
import type { Project } from '../data/projects';
import ProjectCard from './ProjectCard.astro';

interface Props {
  projects: Project[];
  /** Optional short statement rendered as its own tile in the grid. */
  intro?: string;
  /** Optional filter buttons under the intro; matching projects move to the front. */
  filters?: { key: string; label: string }[];
}

const { projects, intro, filters } = Astro.props;
---

<div class="grid" data-filterable={filters ? '' : undefined}>
  {intro && filters && (
    <div class="intro-tile">
      <p class="intro">{intro}</p>
      <div class="filters" role="group" aria-label="Filter projects">
        <button type="button" class="filter" data-filter="all" aria-pressed="true">Show all</button>
        {filters.map((f) => (
          <button type="button" class="filter" data-filter={f.key} aria-pressed="false">{f.label}</button>
        ))}
      </div>
    </div>
  )}
  {intro && !filters && <p class="intro">{intro}</p>}
  {projects.map((project) => (
    <ProjectCard project={project} />
  ))}
</div>

<script>
  /*
    Filters: the chosen field moves its projects to the front (in their usual
    order) and the remaining ones follow in a random order. "Show all" restores
    the original order. Cards glide to their new places.
  */
  const grid = document.querySelector<HTMLElement>('.grid[data-filterable]');

  if (grid) {
    const cards = [...grid.querySelectorAll<HTMLElement>('a[data-tags], a.card')];
    const original = [...cards];
    const buttons = [...grid.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');

    const shuffle = <T,>(list: T[]) => {
      const a = [...list];
      for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [a[i], a[j]] = [a[j], a[i]];
      }
      return a;
    };

    const apply = (key: string, animate = true) => {
      const before = new Map(cards.map((c) => [c, c.getBoundingClientRect()]));

      let ordered = original;
      if (key !== 'all') {
        const matches = (c: HTMLElement) => (c.dataset.tags ?? '').split(' ').includes(key);
        ordered = [...original.filter(matches), ...shuffle(original.filter((c) => !matches(c)))];
      }
      ordered.forEach((c) => grid.append(c));

      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === key)));

      // Keep the chosen filter in the address, so the view can be linked to.
      const url = new URL(location.href);
      if (key === 'all') url.searchParams.delete('filter');
      else url.searchParams.set('filter', key);
      history.replaceState(null, '', url);

      if (!animate || reduceMotion.matches) return;
      for (const c of cards) {
        const from = before.get(c)!;
        const to = c.getBoundingClientRect();
        const dx = from.left - to.left;
        const dy = from.top - to.top;
        if (!dx && !dy) continue;
        c.animate(
          [{ transform: `translate(${dx}px, ${dy}px)` }, { transform: 'none' }],
          { duration: 600, easing: 'cubic-bezier(0.2, 0.7, 0.2, 1)' },
        );
      }
    };

    buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter ?? 'all')));

    // Arriving with ?filter=land-art (e.g. from the front page) starts with that filter on.
    const start = new URLSearchParams(location.search).get('filter');
    if (start && buttons.some((b) => b.dataset.filter === start)) apply(start, false);
  }
</script>

<style>
  /*
    CSS multi-column, not grid: items keep source order and each
    column stacks by its own content height, so tiles of different
    aspect ratio don't leave shared-row gaps. Collapses to a single
    column (still source order) on mobile.
  */
  .grid {
    column-count: 2;
    column-gap: var(--grid-gap-x);
  }

  /* :global() because ProjectCard's root <a> is scoped to its own
     component and wouldn't otherwise match a plain `.grid > *`. */
  .grid > :global(*) {
    break-inside: avoid;
    margin-bottom: var(--grid-gap-y);
  }

  .intro {
    font-family: var(--font-body);
    font-weight: var(--fw-regular);
    font-size: var(--text-4);
    line-height: var(--line-snug);
    max-width: 26ch;
  }

  .intro-tile .intro {
    margin-bottom: var(--space-6);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-4);
  }

  .filter {
    padding: 0 0 var(--space-1);
    background: none;
    border: none;
    border-bottom: 1px solid transparent;
    appearance: none;
    -webkit-appearance: none;
    font: inherit;
    font-size: var(--text-1);
    color: var(--color-text);
  }

  .filter:hover,
  .filter[aria-pressed='true'] {
    border-bottom-color: var(--color-text);
  }

  @media (max-width: 780px) {
    .grid {
      column-count: 1;
    }
  }
</style>
