---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';
import { withBase } from '../utils/url';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const cardColor = project.color.startsWith('#') ? project.color : `var(--${project.color})`;
---

<a
  class="card"
  href={withBase(`/work/${project.slug}/`)}
  aria-label={`${project.title} — ${project.description}`}
  style={`--card-color: ${cardColor}; --card-aspect: ${project.aspect};`}
>
  {project.cover ? (
    <Image class="cover-image" src={project.cover} alt="" loading="eager" />
  ) : (
    <div class="cover" aria-hidden="true">
      <span class="cover-label">Photo coming soon</span>
    </div>
  )}

  <div class="overlay" aria-hidden="true">
    <p class="overlay-title">{project.title}</p>
    <div class="overlay-bottom">
      <p class="overlay-desc">{project.description}</p>
      {project.year && <span class="overlay-year">{project.year}</span>}
    </div>
  </div>
</a>

<style>
  .card {
    position: relative;
    display: block;
    aspect-ratio: var(--card-aspect);
    overflow: hidden;
    background: #f0f0f0;
    outline-offset: 4px;
  }

  .cover {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding: var(--space-3);
    background: linear-gradient(150deg, #ececec, #f8f8f8);
  }

  .cover-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cover-label {
    font-size: var(--text-1);
    color: var(--color-muted);
  }

  .overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--space-5);
    background: var(--card-color);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .card:hover .overlay,
  .card:focus-visible .overlay {
    opacity: 1;
    transform: translateY(0);
  }

  .overlay-title {
    font-family: var(--font-display);
    font-weight: var(--fw-regular);
    font-size: 64px;
    line-height: var(--line-snug);
  }

  .overlay-bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .overlay-desc {
    font-family: var(--font-body);
    font-size: var(--text-1);
    line-height: var(--line-normal);
    max-width: 32ch;
  }

  .overlay-year {
    font-family: var(--font-body);
    font-size: var(--text-1);
    color: var(--color-text);
    opacity: 0.7;
  }

  @media (prefers-reduced-motion: reduce) {
    .overlay {
      transition: none;
    }
  }
</style>
